//
// BSG GCam (MGC_9.6.080) -- replaces LineageOS Aperture as the system camera
// app. Presigned (its own BSG signature), uses only standard runtime
// permissions (CAMERA, RECORD_AUDIO, storage, etc.), no platform signature
// or priv-app placement needed.
//
android_app_import {
    name: "BSGGCam",
    apk: "BSGGCam.apk",
    presigned: true,
    // targetSdkVersion 35 means this APK must be v2-signed; preprocessed
    // tells Soong not to touch (and so not wreck) that existing signature.
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: [
        "Aperture",
        "Snap",
    ],
}
